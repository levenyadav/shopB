# Copy this file to .env and fill in your real Supabase values.
# Find these in: Supabase Dashboard → Project Settings → API
# NEVER commit the real .env (it is gitignored).

# Vite exposes only vars prefixed with VITE_ to the browser.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Login SMS is sent by NinzaSMS via the `phone-otp` Edge Function. There is NO
# frontend key: the API key is a SERVER secret (never VITE_-prefixed, never in
# the browser bundle). Set it on the function with:
#   supabase secrets set NINZASMS_API_KEY=your-ninzasms-api-key
#   supabase secrets set NINZASMS_SENDER_ID=your-ninzasms-user-id

# Server-only (Edge Functions / migrations). Keep OUT of the frontend bundle.
# Used by the Supabase CLI and edge functions, not by Vite.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PROJECT_REF=YOUR-PROJECT-ref

# NinzaSMS — the login OTP sender (replaced Fast2SMS). The key and the sender
# ID (your NinzaSMS User ID) are Edge Function secrets, NOT bundle vars:
#   supabase secrets set NINZASMS_API_KEY=... NINZASMS_SENDER_ID=...
# Kept here only so scripts/test-ninzasms.js can send a test SMS locally.
# NINZASMS_API_KEY=your-ninzasms-api-key
# NINZASMS_SENDER_ID=your-ninzasms-user-id

# Photos — Cloudflare R2 (replaced Supabase Storage). Server-only: set them as
# Edge Function secrets for r2-upload, never VITE_-prefixed:
#   supabase secrets set R2_ACCOUNT_ID=... R2_ACCESS_KEY_ID=... R2_SECRET_ACCESS_KEY=... \
#     R2_BUCKET=... R2_PUBLIC_URL=https://pub-xxxx.r2.dev
# Kept here too so scripts/migrate-photos can copy the old photos into R2.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL=
